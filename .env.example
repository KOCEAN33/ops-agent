# Copy to .env, which Bun loads on `bun start`. .env is gitignored.

ANTHROPIC_API_KEY=
# An Anthropic model ID.
MODEL=

# The model's price in USD per million tokens, from https://www.anthropic.com/pricing
PRICE_INPUT=
PRICE_OUTPUT=
PRICE_CACHE_READ=
PRICE_CACHE_WRITE=

TURN_CAP_USD=2
MONTHLY_CAP_USD=40

DB_PATH=./ops-agent.sqlite
# A clone of ops-agent-instructions. Leave empty to run on the base instructions alone.
INSTRUCTIONS_DIR=../ops-agent-instructions
PORT=8080
