# Copy to .env, which Bun loads on `bun start`. .env is gitignored.

ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5

# The model's price in USD per million tokens, from
# https://platform.claude.com/docs/en/about-claude/pricing. Change all four with MODEL.
PRICE_INPUT=2
PRICE_OUTPUT=10
PRICE_CACHE_READ=0.10
# The 5-minute cache write price.
PRICE_CACHE_WRITE=2.50

TURN_CAP_USD=2
MONTHLY_CAP_USD=40

DB_PATH=./ops-agent.sqlite
# A clone of ops-agent-instructions. Leave empty to run on the base instructions alone.
INSTRUCTIONS_DIR=../ops-agent-instructions
PORT=8080
