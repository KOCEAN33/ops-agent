# Credentials. Copy to .env, which is gitignored. Settings go in config.yaml
# (config.yaml.example), and `bun start` reads both.
#
# In a pod these are keys of the Secret that secret.name names, synced from the
# secret store. Keep them out of the chart values.

ANTHROPIC_API_KEY=
# The bearer token Alertmanager sends. Generate one with `openssl rand -hex 32`.
# Alertmanager's webhook config reads the same value.
WEBHOOK_TOKEN=
# Read only when discord.channelId and discord.ownerId are set in config.yaml.
# The bot needs the Message Content intent enabled in its settings.
DISCORD_BOT_TOKEN=
# The GitHub App's private key, PEM, PKCS#1 or PKCS#8. Read only when
# github.appId is set in config.yaml.
GITHUB_APP_KEY=
