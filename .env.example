# Copy to .env, which Bun loads on `bun start`. .env is gitignored.

ANTHROPIC_API_KEY=
# The price follows MODEL from the table in src/config.ts.
MODEL=claude-sonnet-5-5

# For a model outside that table, set all four, in USD per million tokens with
# the 5-minute cache write price.
# PRICE_INPUT=
# PRICE_OUTPUT=
# PRICE_CACHE_READ=
# PRICE_CACHE_WRITE=

TURN_CAP_USD=2
MONTHLY_CAP_USD=40

DB_PATH=./ops-agent.sqlite
# The bearer token Alertmanager sends. Generate one with `openssl rand -hex 32`.
WEBHOOK_TOKEN=
# A clone of the operating instructions repository. Leave empty to run on the
# base instructions alone.
INSTRUCTIONS_DIR=
PORT=8080

# Read sources. Each one left empty turns its tools off. In a pod the agent
# finds the Kubernetes API itself, so KUBE_API_URL is for a workstation running
# `kubectl proxy`, such as http://127.0.0.1:8001.
KUBE_API_URL=
PROMETHEUS_URL=
LOKI_URL=
# The parent of the GitOps clones at main: owner/name is cloned at
# <GITOPS_DIR>/<name>/current. Needs GITOPS_REPOS.
GITOPS_DIR=

# The Discord bot. Set all three or none: with none, posts wait in the store.
# The bot needs the Message Content intent enabled in its settings.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# The only user whose replies and button presses act.
DISCORD_OWNER_ID=
# Comma-separated hosts whose links survive in posts and issues. Every other
# link is removed.
# Which hosts belong here: Threat model in docs/design.md.
LINK_ALLOWLIST=

# The GitHub App that opens issues on the GitOps repositories. Set both or
# neither: with neither, hand-offs wait in the store. Issues also need
# GITOPS_REPOS. The App needs issues write on each listed repository.
GITHUB_APP_ID=
# The App's private key, PEM, as GitHub issues it.
GITHUB_APP_KEY=
# Comma-separated owner/name of each GitOps repository, such as
# example-owner/example-platform,example-owner/example-apps. The first is the
# default issue repository. Names, the part after the owner, must be unique.
GITOPS_REPOS=
