# Settings. Copy to config.env, which is gitignored. Credentials go in .env
# (.env.example), and `bun start` loads both.
#
# In a pod the chart sets every variable here, so the deployment never writes
# env by hand. A setting comes from the chart value after its arrow, and a
# local-only one is fixed by the chart or found by the agent.

# --- From chart values ---

# -> model. The price follows it from the table in src/config.ts.
MODEL=claude-sonnet-5-5
# -> price.{input,output,cacheRead,cacheWrite}. For a model outside that table,
# set all four, in USD per million tokens with the 5-minute cache write price.
# PRICE_INPUT=
# PRICE_OUTPUT=
# PRICE_CACHE_READ=
# PRICE_CACHE_WRITE=
# -> turnCapUsd. Above one call's worst case, about 0.4 USD on Claude Sonnet 5.5
# with a long history, or a long session's first call is refused.
TURN_CAP_USD=1
# -> monthlyCapUsd. Under the Anthropic credit.
MONTHLY_CAP_USD=50

# -> prometheusUrl, lokiUrl. Each left empty turns its tools off.
PROMETHEUS_URL=
LOKI_URL=

# -> discord.channelId, discord.ownerId. Both set turn the bot on, and with
# neither, posts wait in the store.
DISCORD_CHANNEL_ID=
# The only user whose replies and button presses act.
DISCORD_OWNER_ID=
# -> linkAllowlist. Comma-separated hosts whose links survive in posts and
# issues. Every other link is removed.
# Which hosts belong here: Threat model in docs/design.md.
LINK_ALLOWLIST=

# -> github.appId. Set turns issues on, and with it unset, hand-offs wait in
# the store. Issues also need GITOPS_REPOS, and the App needs issues write on
# each listed repository.
GITHUB_APP_ID=
# -> github.gitopsRepos. Comma-separated owner/name of each GitOps repository,
# such as example-owner/example-platform,example-owner/example-apps. The first
# is the default issue repository. Names, the part after the owner, must be
# unique. Needed by the GitOps read tools and by issues.
GITOPS_REPOS=

# --- Local only: in a pod, the chart or the agent sets these ---

# Pod: /data/ops-agent.sqlite on the PVC.
DB_PATH=./ops-agent.sqlite
# Pod: 8080.
PORT=8080
# Pod: unset, since the agent finds the API server and its ServiceAccount
# itself. Locally, a workstation running `kubectl proxy`, such as
# http://127.0.0.1:8001. Empty turns the Kubernetes tools off.
KUBE_API_URL=
# Pod: /repos/gitops, filled by one git-sync sidecar per github.gitopsRepos
# entry. Locally, the parent of clones at main: owner/name is cloned at
# <GITOPS_DIR>/<name>/current. Empty turns the GitOps read tools off.
GITOPS_DIR=
# Pod: /repos/instructions/current when github.instructionsRepo is set.
# Locally, a clone of the operating instructions repository. Empty runs on the
# base instructions alone.
INSTRUCTIONS_DIR=
